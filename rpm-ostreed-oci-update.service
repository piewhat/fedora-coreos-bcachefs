[Unit]
Description=rpm-ostree OCI registry upgrade and reboot
ConditionPathExists=/run/ostree-booted
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=infinity
# --reboot only triggers if a new image version is successfully pulled.
# If you'd rather stage updates and reboot on your own schedule, change
# this to `rpm-ostree upgrade` via:
#   systemctl edit rpm-ostreed-oci-update.service
ExecStart=/usr/bin/rpm-ostree upgrade --reboot
